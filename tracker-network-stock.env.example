# ── Discord ────────────────────────────────────────────────────────────────
# Without a token the tracker runs headless and logs events instead.
DISCORD_BOT_TOKEN=replace-me
# Important alerts (back in stock, Early Access, new listing, relisted) with pings.
DISCORD_CHANNEL_ID=123456789012345678
# Optional: routine radar (sold out, price changes, restock ETAs, delisted). Defaults to the above.
# DISCORD_RADAR_CHANNEL_ID=
# Optional: your server ID for instant slash-command sync (global sync can take up to an hour).
# DISCORD_GUILD_ID=
# Optional: extra mention on important alerts, e.g. <@&role_id> or @here
# DISCORD_ALERT_MENTION=
# Optional: user IDs allowed to run admin commands (besides Manage Server permission).
# DISCORD_ADMIN_USER_IDS=
# DISCORD_MENTION_KINDS=back_in_stock,early_access,new_listing,relisted,deal
# DISCORD_ALERT_COOLDOWN_MINUTES=10
# DISCORD_DIGEST_THRESHOLD=5

# ── Storage and logging ────────────────────────────────────────────────────
# Data dir holds tracker.db (SQLite). STOCK_BOT_DATA_DIR is also honored.
# TRACKER_DATA_DIR=data
# TRACKER_LOG_LEVEL=INFO
# TRACKER_LOG_FILE=logs/tracker.log
# TRACKER_LOG_JSON=false
# Import the old bot's watchlist.json / subscribers.json once on first start.
# TRACKER_AUTO_IMPORT_LEGACY=true

# ── Ubiquiti store ─────────────────────────────────────────────────────────
# Regions to track (comma-separated): us, ca, uk, eu
# UNIFI_STORE_REGIONS=us
# UNIFI_STORE_EXTRA_CATEGORIES=

# ── Polling cadence ────────────────────────────────────────────────────────
# TRACKER_MONITOR_CATALOG_INTERVAL_SECONDS=300
# TRACKER_MONITOR_HOME_INTERVAL_SECONDS=60
# TRACKER_MONITOR_HOT_TICK_SECONDS=10
# TRACKER_MONITOR_HOT_PRODUCTS_PER_TICK=4
# TRACKER_MONITOR_HOT_POLL_INTERVAL_SECONDS=60
# TRACKER_MONITOR_DELIST_GRACE_MINUTES=45
# TRACKER_MONITOR_EVENT_MAX_AGE_MINUTES=60
# Other retailers (Amazon, Best Buy, B&H, Newegg). These sites often block bots.
# TRACKER_RETAIL_AMAZON_INTERVAL_SECONDS=300
# TRACKER_RETAIL_BESTBUY_INTERVAL_SECONDS=120
# TRACKER_RETAIL_BHPHOTO_INTERVAL_SECONDS=60
# TRACKER_RETAIL_NEWEGG_INTERVAL_SECONDS=60

# ── HTTP politeness ────────────────────────────────────────────────────────
# TRACKER_HTTP_PER_HOST_CONCURRENCY=2
# TRACKER_HTTP_PER_HOST_MIN_INTERVAL_SECONDS=1.0
# TRACKER_HTTP_MAX_RETRIES=3

# ── Resale data: eBay developer app (optional, Production keyset) ─────────
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_MARKETPLACE=EBAY_US
# EBAY_USE_MARKETPLACE_INSIGHTS=true

# ── Resale valuation ───────────────────────────────────────────────────────
# TRACKER_MARKET_FEE_RATE=0.136
# TRACKER_MARKET_FIXED_FEE_CENTS=40
# TRACKER_MARKET_OUTBOUND_SHIPPING_CENTS=1200
# TRACKER_MARKET_PURCHASE_TAX_RATE=0
# TRACKER_MARKET_INBOUND_SHIPPING_CENTS=0
# TRACKER_MARKET_MIN_COMPS=3
# TRACKER_MARKET_DEAL_MIN_PROFIT_CENTS=3000
# TRACKER_MARKET_DEAL_MIN_ROI=0.15
# TRACKER_MARKET_MIN_RETAIL_CENTS=4000
# TRACKER_MARKET_REFRESH_HOT_HOURS=6
# TRACKER_MARKET_REFRESH_HOURS=72

# ── SMS via Twilio (optional) ──────────────────────────────────────────────
SMS_ENABLED=false
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15551234567
# SMS_TO_NUMBERS=+15557654321,+15559876543
# SMS_KINDS=back_in_stock,early_access,deal

# ── Message cleanup (optional) ─────────────────────────────────────────────
# Deletes this bot's own messages older than the TTL from its channels.
MESSAGE_CLEANUP_ENABLED=false
# MESSAGE_CLEANUP_TTL_MINUTES=60
# MESSAGE_CLEANUP_INTERVAL_MINUTES=10
# MESSAGE_CLEANUP_MAX_DELETES_PER_RUN=25
